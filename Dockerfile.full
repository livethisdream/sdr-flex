# Everything. One command, and the tool can hear a radio and read what it says.
#
#   SDRFLEX_DOCKERFILE=Dockerfile.full docker compose up -d --build
#
# The other three images are each a deliberate subset:
#
#   Dockerfile           Node and this repository. Nothing else, because a server that
#                        reads captures needs nothing else. Tens of megabytes.
#   Dockerfile.decoders  ...plus the five decoders that come from a distribution.
#   Dockerfile.radio     ...plus the vendor capture programs a live radio needs.
#   Dockerfile.full      ...plus GNU Radio, and the three decoders that have to be built:
#                        gr-lora_sdr, m17-cxx-demod and redsea.
#
# This one is a couple of gigabytes and takes ten to twenty minutes to build, nearly all
# of it compiling gr-lora_sdr. That is the trade, and it is why it is a fourth file
# rather than the default: most sessions never touch LoRa or M17, and the smaller images
# build in seconds. Take this one when you want every decoder the adapter table knows
# about without installing any of them on your own machine.
#
# The tool still installs nothing of its own and links against none of this. Every
# decoder here is a program run at arm's length over a pipe — which is what keeps a GPL
# decoder's license its own business (ADR-0015), a segfaulting one a broken pipe rather
# than a dead session (ADR-0013), and a GNU Radio flowgraph just another program
# (ADR-0032).
#
# **Ubuntu, where the other three are Debian.** Not a preference — GNU Radio is the
# whole reason this file exists, and noble carries 3.10.9.2 where bookworm carries
# 3.10.5.1. Every flowgraph in server/flowgraphs/ and both built decoders were checked
# against 3.10.9.2. The second reason is quieter and bites harder: GNU Radio binds its
# Python against exactly one CPython, and the commonest way for this to go wrong on a
# real machine is to have several. Here `python3` is 3.12 and it is the one the
# bindings were built for, so there is only ever one answer.

# ---------------------------------------------------------------- build stage

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

# Compilers, GNU Radio's headers, the two libraries m17-cxx-demod links against, and
# redsea's three. None of this reaches the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates \
      gnuradio-dev pybind11-dev python3-dev libspdlog-dev \
      libcodec2-dev libboost-program-options-dev \
      meson ninja-build libsndfile1-dev libliquid-dev nlohmann-json3-dev \
      curl libao-dev libfftw3-dev libusb-1.0-0-dev \
 && rm -rf /var/lib/apt/lists/*

# Pinned, because "whatever HEAD was that day" is not a build you can repeat. These are
# the commits the adapters in server/adapters.js were checked against. Moving a pin is a
# one-line change and a re-run of web/test/adapters.test.mjs.
ARG LORA_SDR_REF=862746dd1cf635c9c8a4bfbaa2c3a0ec3a5306c9
ARG M17_REF=9b8cec24d3f8d5e9f7f6e9c23661439e32343d6b
# M17's two modes are two upstreams. `m17-cxx-demod` above reads stream mode (voice);
# packet mode (SMS and data) is `m17-packet-decode`, which lives in M17_Implementations
# and links against libm17. Neither build contains the other's program.
ARG LIBM17_REF=07926d08ade8509f1ce55d0289f229ab44cbcf51
ARG M17_IMPL_REF=f80793f169751b1fd2de6aaf8de52f862360142c
ARG REDSEA_REF=v1.3.1
ARG NRSC5_REF=v3.1.0
ARG WHISPER_REF=v1.9.4
# Which speech model. `base.en` is 142 MB and is the smallest that is worth listening
# to; `tiny.en` (75 MB) drops words out of anything noisy and `small.en` (466 MB) is
# better and triples this layer. English-only because the `.en` models are measurably
# better at English than the multilingual ones of the same size, and a voice channel
# somebody is transcribing is usually one they already know the language of.
ARG WHISPER_MODEL=ggml-base.en.bin

# Staged under its own prefix, so what gets copied into the runtime image is exactly the
# two things built here and nothing the build stage happened to leave lying about.
ENV OOT=/opt/oot

# LoRa. gr-lora_sdr is a GNU Radio out-of-tree module rather than a program: there is no
# binary, only a Python package that server/flowgraphs/lora.py imports.
#
# GR_PYTHON_DIR is named rather than left to be worked out. GNU Radio's cmake recognizes
# a Debian layout and installs to `dist-packages` — but only when the prefix is one it
# recognizes, and this one is not, so it falls back to `site-packages`, which is not on
# a Debian interpreter's path. The module then installs perfectly and does not import.
RUN PYDIR="$OOT/lib/python$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')/dist-packages" \
 && git clone https://github.com/tapparelj/gr-lora_sdr /tmp/gr-lora_sdr \
 && git -C /tmp/gr-lora_sdr checkout --quiet "$LORA_SDR_REF" \
 && cmake -S /tmp/gr-lora_sdr -B /tmp/gr-lora_sdr/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
      -DGR_PYTHON_DIR="$PYDIR" \
      -DPYTHON_EXECUTABLE=/usr/bin/python3 \
 && cmake --build /tmp/gr-lora_sdr/build -j"$(nproc)" \
 && cmake --install /tmp/gr-lora_sdr/build \
 && rm -rf /tmp/gr-lora_sdr

# M17. A plain command-line program, submodules and all.
RUN git clone https://github.com/mobilinkd/m17-cxx-demod /tmp/m17 \
 && git -C /tmp/m17 checkout --quiet "$M17_REF" \
 && git -C /tmp/m17 submodule update --init --recursive \
 && cmake -S /tmp/m17 -B /tmp/m17/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
 && cmake --build /tmp/m17/build -j"$(nproc)" \
 && cmake --install /tmp/m17/build \
 && rm -rf /tmp/m17

# M17 packet mode, which is a different program from a different upstream — see the note
# on the pins above. libm17 first, because the tools link against it.
RUN git clone https://github.com/M17-Project/libm17 /tmp/libm17 \
 && git -C /tmp/libm17 checkout --quiet "$LIBM17_REF" \
 && cmake -S /tmp/libm17 -B /tmp/libm17/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
 && cmake --build /tmp/libm17/build -j"$(nproc)" \
 && cmake --install /tmp/libm17/build \
 && rm -rf /tmp/libm17

# And the tools, which are a plain Makefile with no install target worth using — it
# shells out to sudo. Both are built: the decoder is what the adapter runs, and the
# encoder is what `fixtures/make.mjs` regenerates the packet fixture with.
RUN git clone --recursive https://github.com/M17-Project/M17_Implementations /tmp/m17impl \
 && git -C /tmp/m17impl checkout --quiet "$M17_IMPL_REF" \
 && make -C /tmp/m17impl/SP5WWP/m17-packet \
      CPATH="$OOT/include" LIBRARY_PATH="$OOT/lib" \
 && install -d "$OOT/bin" \
 && install -m 0755 /tmp/m17impl/SP5WWP/m17-packet/m17-packet-decode "$OOT/bin/" \
 && install -m 0755 /tmp/m17impl/SP5WWP/m17-packet/m17-packet-encode "$OOT/bin/" \
 && rm -rf /tmp/m17impl

# HD Radio. Its own receiver rather than gr-nrsc5, because what this needs is the
# receiving half and that is a self-contained C program: samples on stdin, station name,
# song and file announcements on stderr. gr-nrsc5 is the transmitter side and would drag
# in a patched fdk-aac to encode audio nothing here is encoding.
RUN git clone https://github.com/theori-io/nrsc5 /tmp/nrsc5 \
 && git -C /tmp/nrsc5 checkout --quiet "$NRSC5_REF" \
 && cmake -S /tmp/nrsc5 -B /tmp/nrsc5/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
      -DUSE_COLOR=OFF \
 && cmake --build /tmp/nrsc5/build -j"$(nproc)" \
 && cmake --install /tmp/nrsc5/build \
 && rm -rf /tmp/nrsc5

# Speech to text. CPU only: this image has no GPU to find, and whisper's CPU path is
# perfectly usable on the length of audio a radio channel produces — seconds at a time,
# not hours. The shared libraries go to $OOT with everything else and `ldconfig` in the
# runtime stage finds them.
RUN git clone https://github.com/ggml-org/whisper.cpp /tmp/whisper \
 && git -C /tmp/whisper checkout --quiet "$WHISPER_REF" \
 && cmake -S /tmp/whisper -B /tmp/whisper/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
      -DWHISPER_BUILD_TESTS=OFF \
      -DWHISPER_BUILD_SERVER=OFF \
      -DGGML_NATIVE=OFF \
 && cmake --build /tmp/whisper/build -j"$(nproc)" \
 && cmake --install /tmp/whisper/build \
 && install -d "$OOT/bin" \
 && install -m 0755 /tmp/whisper/build/bin/whisper-cli "$OOT/bin/" \
 && rm -rf /tmp/whisper

# The weights, which are the one thing here that is downloaded rather than built. Kept
# in its own layer so changing the model does not rebuild whisper, and named `model.bin`
# so the adapter has one path to look at whichever model was chosen.
RUN install -d "$OOT/share/whisper" \
 && curl -fsSL -o "$OOT/share/whisper/model.bin" \
      "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$WHISPER_MODEL" \
 && test -s "$OOT/share/whisper/model.bin"

# RDS. Meson rather than cmake, and no distribution packages it — which is the only
# reason it is here rather than in Dockerfile.decoders with the other five.
RUN git clone https://github.com/windytan/redsea /tmp/redsea \
 && git -C /tmp/redsea checkout --quiet "$REDSEA_REF" \
 && meson setup /tmp/redsea/build /tmp/redsea \
      --buildtype=release --prefix="$OOT" \
 && meson install -C /tmp/redsea/build \
 && rm -rf /tmp/redsea

# SoapySDR's capture program. Not a decoder and not GNU Radio — it is here because it is
# the one radio driver in server/radio.js whose program no distribution packages.
# `soapysdr-tools` sounds like the answer and is not: it provides `SoapySDRUtil`, which
# enumerates devices and cannot record one. `rx_sdr` comes from rx_tools, it is a few
# hundred lines, and building it is the difference between the Soapy driver working in
# this image and being listed greyed out in it.
ARG RX_TOOLS_REF=811b21c4c8a592515279bd19f7460c6e4ff0551c
RUN apt-get update && apt-get install -y --no-install-recommends \
      libsoapysdr-dev librtlsdr-dev pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && git clone https://github.com/rxseger/rx_tools /tmp/rx_tools \
 && git -C /tmp/rx_tools checkout --quiet "$RX_TOOLS_REF" \
 && cmake -S /tmp/rx_tools -B /tmp/rx_tools/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="$OOT" \
 && cmake --build /tmp/rx_tools/build -j"$(nproc)" \
 && cmake --install /tmp/rx_tools/build \
 && rm -rf /tmp/rx_tools

# ---------------------------------------------------------------- runtime

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# The vendor capture programs, one per driver in server/radio.js. The Pluto needs none
# of them — it is a network device, and the protocol is spoken directly (ADR-0030).
# `libao4` and `libfftw3-single3` are nrsc5's, not the radios'. It is copied in as a
# binary from the build stage and a binary does not bring its shared libraries with it —
# `rtl-sdr` below already supplies librtlsdr, libusb and libudev, and `ldd` lists these
# two as the rest. Without them the binary is present and will not start, which the
# verification line further down turns into a failed build rather than a dead menu entry.

RUN apt-get update && apt-get install -y --no-install-recommends \
      libiio-utils \
      rtl-sdr \
      soapysdr-tools soapysdr-module-rtlsdr \
      uhd-host \
      ca-certificates \
      libao4 libfftw3-single3 \
 && rm -rf /var/lib/apt/lists/*

# The decoders that come packaged, one per adapter in server/adapters.js. An adapter
# whose program is missing is still listed in the menu, greyed, naming what it wants —
# so dropping any of these costs a decoder rather than breaking the image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      rtl-433 \
      multimon-ng \
      dump1090-mutability \
      direwolf \
      minimodem \
 && rm -rf /var/lib/apt/lists/*

# GNU Radio itself — runtime and Python bindings, not the headers. Most of the size of
# this image, and the reason the other three do not have it.
#
# Then the shared libraries the two built programs need. They are named here rather than
# left to arrive as a side effect of some -dev package, because a dependency that comes
# in by accident goes out by accident too.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnuradio \
      python3-numpy \
      libcodec2-1.2 \
      libboost-program-options1.83.0 \
      libsoapysdr0.8 \
      libsndfile1 libliquid1 \
 && rm -rf /var/lib/apt/lists/*

# Node, from the image that builds it properly. The server is Node's own http, net and
# crypto and nothing else, so one binary is the whole runtime — no npm, no modules, no
# package manager to add to this image. Node 22 or newer; Ubuntu 24.04 ships 18.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node

# The three that had to be built. ldconfig so the loader finds libgnuradio-lora_sdr, and
# /usr/local/lib/python3.12/dist-packages is already on this Python's sys.path, so the
# flowgraph imports it with no PYTHONPATH to set.
COPY --from=build /opt/oot/ /usr/local/
RUN ldconfig

# Fail the build rather than the first click. A decoder whose program is missing is not
# in the menu at all — which is the correct behavior and a terrible way to find out that
# an image did not build what it said it did.
#
# **Grep the output, do not trust the exit code.** `m17-packet-decode -h` prints its
# usage and exits **255**, which is a perfectly ordinary thing for a small C program to
# do and which broke this whole image: the `&&` chain below stopped there, so the build
# failed on the one line that was supposed to prove the build had worked. Matching a
# string from the help text tests more anyway — it proves the binary ran, which means
# libm17 resolved, and that it is the program we think it is.
RUN node --version \
 && python3 -c "from gnuradio import lora_sdr" && echo 'lora_sdr ok' \
 && m17-demod --help > /dev/null && m17-mod --help > /dev/null && echo 'm17 ok' \
 && m17-packet-decode -h 2>&1 | grep -q 'decode callsigns' && echo 'm17 packet ok' \
 && redsea --version > /dev/null && echo 'redsea ok' \
 && nrsc5 -h 2>&1 | grep -q 'iq-input-format' && echo 'nrsc5 ok' \
 && command -v rx_sdr > /dev/null && echo 'rx_sdr ok'

# Speech gets a harder check than the others: it *runs a decode*.
#
# The rest of this file proves a program exists and can be started. That was not enough
# for the M17 line above, and it would be less than enough here — the thing most likely
# to break about whisper is not the binary, it is the three-part arrangement the adapter
# depends on: a WAV arriving on stdin as `-f -`, the model loading from a fixed path,
# and full JSON coming back on **stdout** rather than a file because of `-of -`. Any one
# of those silently changing turns the decoder into one that always reports silence.
#
# So: half a second of synthesized tone through the real binary and the real model, and
# the JSON has to come back with a `transcription` array in it. What it transcribes is
# not the point and is expected to be nothing — a tone is not speech, and a model that
# says so is the model behaving. What is being tested is the plumbing.
RUN python3 -c "import struct, math, sys; \
n=8000; d=b''.join(struct.pack('<h', int(8000*math.sin(i*2*math.pi*440/16000))) for i in range(n)); \
sys.stdout.buffer.write(b'RIFF'+struct.pack('<I',36+len(d))+b'WAVEfmt '+struct.pack('<IHHIIHH',16,1,1,16000,32000,2,16)+b'data'+struct.pack('<I',len(d))+d)" \
    > /tmp/probe.wav \
 && whisper-cli -m /usr/local/share/whisper/model.bin -f - -ojf -of - -l en -tp 0 \
      < /tmp/probe.wav 2>/tmp/probe.err | tee /tmp/probe.json | grep -q '"transcription"' \
 && python3 -c "import json; json.load(open('/tmp/probe.json'))" \
 && echo 'whisper ok' \
 || (echo 'whisper FAILED — stderr follows'; cat /tmp/probe.err; exit 1)
# The same treatment for the HD Radio receiver: noise through the real binary on stdin,
# which must come back "never synchronized" rather than a usage error. That tests the two
# things the adapter depends on and the help text does not — that `-r -` reads stdin, and
# that with `-r` set it wants the program number as its only positional argument.
RUN head -c 4000000 /dev/urandom \
    | nrsc5 --iq-input-format cs16 -r - -o /dev/null 0 2>/tmp/n5.err; \
    grep -qv 'Usage:' /tmp/n5.err && echo 'nrsc5 reads stdin ok' \
 || (echo 'nrsc5 FAILED — it rejected the arguments the adapter passes'; cat /tmp/n5.err; exit 1)

RUN rm -f /tmp/probe.wav /tmp/probe.json /tmp/probe.err /tmp/n5.err

RUN useradd --system --create-home --shell /usr/sbin/nologin sdrflex
WORKDIR /app

COPY web ./web
COPY server ./server
COPY fixtures ./fixtures
COPY seed-captures.mjs ./

VOLUME /captures
# One path the adapter looks at, whichever model the image was built with.
ENV SDRFLEX_WHISPER_MODEL=/usr/local/share/whisper/model.bin

ENV SDRFLEX_CAPTURES=/captures \
    SDRFLEX_PORT=8722 \
    SDRFLEX_BIND=0.0.0.0 \
    SDRFLEX_RINGS=/rings

# direwolf will not start without a config file on a machine with no sound card, and a
# container is always that machine. The adapter writes one per run into a temp
# directory, so this needs a writable TMPDIR and nothing else.
ENV TMPDIR=/tmp

# Ring recordings are scratch, and large: sixty seconds of 2.4 MS/s cu8 is 288 MB. Its
# own directory so it can be mounted onto a real disk when the container's writable
# layer is somewhere you would rather not put that.
RUN mkdir -p /rings && chown sdrflex /rings
VOLUME /rings

EXPOSE 8722
USER sdrflex

HEALTHCHECK --interval=30s --timeout=3s --start-period=3s \
  CMD node -e "fetch('http://127.0.0.1:8722/index.html').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/main.js"]
