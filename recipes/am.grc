options:
  parameters:
    author: SDR Flex
    category: '[SDR Flex]'
    description: 'AM: the envelope, then the post-detection low-pass every receiver has, a
      moving average of smoothUs microseconds (40 by default, 0 for none) centered on its
      output so edges stay where they were. history is how many inputs come before the first
      whole output, lead how many after.'
    generate_options: hb
    hier_block_src_path: '.:'
    id: sdrflex_am
    output_language: python
    title: AM demod
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: parameter
  parameters:
    hide: none
    label: Sample rate
    short_id: ''
    type: eng_float
    value: '25000'
  states:
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: smoothUs
  id: parameter
  parameters:
    hide: none
    label: Smoothing (us, 0 for none)
    short_id: ''
    type: eng_float
    value: '40'
  states:
    coordinate: [200, 120]
    rotation: 0
    state: enabled
- name: recipe
  id: sdrflex_recipe
  parameters:
    kind: node
    node: core.am_envelope
    input: iq
    output: real
    derived: ''
    history: history
    lead: lead
    listen: 'no'
    comment: ''
  states:
    coordinate: [8, 320]
    rotation: 0
    state: enabled
- name: window_len
  id: variable
  parameters:
    value: 1 if smoothUs <= 0 else max(2, int(samp_rate * smoothUs * 1e-6 + 0.5))
  states:
    coordinate: [344, 8]
    rotation: 0
    state: enabled
- name: lead
  id: variable
  parameters:
    value: window_len // 2
  states:
    coordinate: [480, 8]
    rotation: 0
    state: enabled
- name: history
  id: variable
  parameters:
    value: window_len - 1 - lead
  states:
    coordinate: [584, 8]
    rotation: 0
    state: enabled
- name: pad_source_0
  id: pad_source
  parameters:
    label: in
    num_streams: '1'
    optional: 'False'
    type: complex
    vlen: '1'
  states:
    coordinate: [8, 232]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    vlen: '1'
  states:
    coordinate: [160, 232]
    rotation: 0
    state: enabled
- name: blocks_moving_average_xx_0
  id: blocks_moving_average_xx
  parameters:
    length: window_len
    max_iter: '4000'
    scale: 1.0 / window_len
    type: float
    vlen: '1'
  states:
    coordinate: [344, 216]
    rotation: 0
    state: enabled
- name: blocks_skiphead_0
  id: blocks_skiphead
  parameters:
    num_items: lead
    type: float
    vlen: '1'
  states:
    coordinate: [560, 232]
    rotation: 0
    state: enabled
- name: pad_sink_0
  id: pad_sink
  parameters:
    label: out
    num_streams: '1'
    optional: 'False'
    type: float
    vlen: '1'
  states:
    coordinate: [744, 232]
    rotation: 0
    state: enabled

connections:
- [pad_source_0, '0', blocks_complex_to_mag_0, '0']
- [blocks_complex_to_mag_0, '0', blocks_moving_average_xx_0, '0']
- [blocks_moving_average_xx_0, '0', blocks_skiphead_0, '0']
- [blocks_skiphead_0, '0', pad_sink_0, '0']

metadata:
  file_format: 1
