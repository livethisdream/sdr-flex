options:
  parameters:
    author: SDR Flex
    category: '[SDR Flex]'
    description: 'Soft symbols: a root-raised-cosine matched filter, read once a symbol on a fixed grid,
      centered and scaled so the outer levels sit at +-3. Output k is the filter at phase
      + k symbols; history is how many inputs come before the first instant. The grid,
      center and gain are fitted by SDR Flex, on each ten seconds of the capture.'
    generate_options: hb
    hier_block_src_path: '.:'
    id: sdrflex_symbols
    output_language: python
    title: Symbol sync
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: parameter
  parameters:
    hide: none
    label: Sample rate
    short_id: ''
    type: eng_float
    value: '48000'
  states:
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: symbolRate
  id: parameter
  parameters:
    hide: none
    label: Symbol rate
    short_id: ''
    type: eng_float
    value: '4800'
  states:
    coordinate: [328, 8]
    rotation: 0
    state: enabled
- name: alpha
  id: parameter
  parameters:
    hide: none
    label: Roll-off
    short_id: ''
    type: eng_float
    value: '0.5'
  states:
    coordinate: [456, 8]
    rotation: 0
    state: enabled
- name: span
  id: parameter
  parameters:
    hide: none
    label: Filter span (symbols)
    short_id: ''
    type: intx
    value: '8'
  states:
    coordinate: [584, 8]
    rotation: 0
    state: enabled
- name: phase
  id: parameter
  parameters:
    hide: none
    label: Grid phase (samples)
    short_id: ''
    type: eng_float
    value: '0'
  states:
    coordinate: [712, 8]
    rotation: 0
    state: enabled
- name: center
  id: parameter
  parameters:
    hide: none
    label: Center
    short_id: ''
    type: eng_float
    value: '0'
  states:
    coordinate: [840, 8]
    rotation: 0
    state: enabled
- name: gain
  id: parameter
  parameters:
    hide: none
    label: Gain
    short_id: ''
    type: eng_float
    value: '1'
  states:
    coordinate: [968, 8]
    rotation: 0
    state: enabled
- name: invert
  id: parameter
  parameters:
    hide: none
    label: Invert
    short_id: ''
    type: str
    value: 'no'
  states:
    coordinate: [1096, 8]
    rotation: 0
    state: enabled
- name: recipe
  id: sdrflex_recipe
  parameters:
    kind: node
    node: core.symbols
    input: real
    output: real
    derived: phase=level-fit,center=level-fit,gain=level-fit
    history: history
    lead: half
    listen: 'no'
    comment: ''
  states:
    coordinate: [8, 320]
    rotation: 0
    state: enabled
- name: imports
  id: import
  parameters:
    imports: import math
  states:
    coordinate: [8, 120]
    rotation: 0
    state: enabled
- name: step
  id: variable
  parameters:
    value: samp_rate / symbolRate
  states:
    coordinate: [200, 120]
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters:
    value: 2 * round(span * step / 2) + 1
  states:
    coordinate: [320, 120]
    rotation: 0
    state: enabled
- name: rrc
  id: variable
  parameters:
    value: firdes.root_raised_cosine(1.0, samp_rate, symbolRate, alpha, ntaps)
  states:
    coordinate: [440, 120]
    rotation: 0
    state: enabled
- name: taps
  id: variable
  parameters:
    value: '[t * (1 - alpha + 4 * alpha / math.pi) / math.sqrt(step) / max(rrc) for t in rrc]'
  states:
    coordinate: [560, 120]
    rotation: 0
    state: enabled
- name: half
  id: variable
  parameters:
    value: (ntaps - 1) // 2
  states:
    coordinate: [680, 120]
    rotation: 0
    state: enabled
- name: first
  id: variable
  parameters:
    value: phase
  states:
    coordinate: [800, 120]
    rotation: 0
    state: enabled
- name: skip
  id: variable
  parameters:
    value: int(math.floor(first))
  states:
    coordinate: [920, 120]
    rotation: 0
    state: enabled
- name: mu
  id: variable
  parameters:
    value: first - skip
  states:
    coordinate: [1040, 120]
    rotation: 0
    state: enabled
- name: history
  id: variable
  parameters:
    value: half + 3
  states:
    coordinate: [1160, 120]
    rotation: 0
    state: enabled
- name: sign
  id: variable
  parameters:
    value: '-1 if invert == ''yes'' else 1'
  states:
    coordinate: [1280, 120]
    rotation: 0
    state: enabled
- name: pad_source_0
  id: pad_source
  parameters:
    label: in
    num_streams: '1'
    optional: 'False'
    type: float
    vlen: '1'
  states:
    coordinate: [8, 232]
    rotation: 0
    state: enabled
- name: fir_filter_xxx_0
  id: fir_filter_xxx
  parameters:
    decim: '1'
    samp_delay: '0'
    taps: taps
    type: fff
  states:
    coordinate: [136, 232]
    rotation: 0
    state: enabled
- name: blocks_skiphead_0
  id: blocks_skiphead
  parameters:
    num_items: ntaps - 1 + skip
    type: float
  states:
    coordinate: [304, 232]
    rotation: 0
    state: enabled
- name: mmse_resampler_xx_0
  id: mmse_resampler_xx
  parameters:
    phase_shift: mu
    resamp_ratio: step
    type: float
  states:
    coordinate: [456, 232]
    rotation: 0
    state: enabled
- name: blocks_add_const_vxx_0
  id: blocks_add_const_vxx
  parameters:
    const: -center
    type: float
    vlen: '1'
  states:
    coordinate: [640, 232]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    const: sign * gain
    type: float
    vlen: '1'
  states:
    coordinate: [800, 232]
    rotation: 0
    state: enabled
- name: pad_sink_0
  id: pad_sink
  parameters:
    label: out
    num_streams: '1'
    optional: 'False'
    type: float
    vlen: '1'
  states:
    coordinate: [960, 232]
    rotation: 0
    state: enabled

connections:
- [pad_source_0, '0', fir_filter_xxx_0, '0']
- [fir_filter_xxx_0, '0', blocks_skiphead_0, '0']
- [blocks_skiphead_0, '0', mmse_resampler_xx_0, '0']
- [mmse_resampler_xx_0, '0', blocks_add_const_vxx_0, '0']
- [blocks_add_const_vxx_0, '0', blocks_multiply_const_vxx_0, '0']
- [blocks_multiply_const_vxx_0, '0', pad_sink_0, '0']

metadata:
  file_format: 1
